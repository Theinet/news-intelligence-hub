# Runtime
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_PORT=3000
WEB_PORT=5173

# Database and queues
DATABASE_URL=postgresql://nih:nih_password@postgres:5432/nih
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Queue admin panel
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me
SHOW_QUEUE_LINK=true

# RSS polling
FEED_POLL_CRON=*/10 * * * *
FEED_REQUEST_TIMEOUT_MS=10000

# Article pre-filter
MIN_ARTICLE_CHARS=600
SEO_SPAM_TERMS=casino,betting,loan,promo code

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=1600
LLM_CONCURRENCY=2
LLM_MOCK=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Demo
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=Password123!
